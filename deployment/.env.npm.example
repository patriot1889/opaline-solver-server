# Solver host private LAN or VPN IPv4 address, reachable from the NPM host.
# Use an address assigned to this server, not the NPM server or a container IP.
SOLVER_BIND_IP=192.168.1.50

# Generate on the server with: openssl rand -hex 32
SOLVER_SECRET=

# Preferred integrity-token route: google or youtube.
GENERATE_IT_ENDPOINT=google
