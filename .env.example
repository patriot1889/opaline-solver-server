# Bare DNS name pointing to this host; ports 80 and 443 must be reachable.
SOLVER_DOMAIN=solver.example.com
# Replace with the output of: npm run --silent secret
SOLVER_SECRET=

# Preferred integrity-token route: google (default) or youtube. A recoverable
# route/integrity rejection gets one fresh-state retry using the other route.
GENERATE_IT_ENDPOINT=google
