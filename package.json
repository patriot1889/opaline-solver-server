{
  "name": "opaline-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "probe": "npm run build && node scripts/probe.mjs",
    "fixtures": "npm run build && node scripts/fixtures.mjs",
    "test:fixtures": "npm run build && node --test tests/players.fixture.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:proxy": "npm run build && node scripts/proxy-smoke.mjs",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": { "bgutils-js": "4.0.3", "express": "5.3.0", "jsdom": "30.1.3" },
  "devDependencies": { "@types/express": "5.0.6", "@types/jsdom": "30.0.0", "@types/node": "24.19.2", "typescript": "6.0.3" }
}
